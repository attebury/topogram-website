---
const { head } = Astro.locals.starlightRoute;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<script>
  import { init, track } from "@plausible-analytics/tracker";

  const domain = "topogram.dev";
  const host = window.location.hostname;
  const isTopogramHost = host === domain || host.endsWith(`.${domain}`);
  const respectsPrivacySignal =
    navigator.globalPrivacyControl === true ||
    navigator.doNotTrack === "1" ||
    window.doNotTrack === "1";

  if (isTopogramHost && !respectsPrivacySignal) {
    init({
      domain,
      autoCapturePageviews: true,
      outboundLinks: true,
      fileDownloads: { fileExtensions: ["txt"] },
      logging: false,
    });

    document.addEventListener(
      "click",
      (event) => {
        const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
        if (!(link instanceof HTMLAnchorElement)) return;

        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return;
        if (url.pathname !== "/llms.txt" && url.pathname !== "/llms-full.txt") return;

        track("LLM File: Click", {
          props: {
            url: url.href,
            label: link.textContent?.replace(/\s+/g, " ").trim().slice(0, 80) || "LLM file",
          },
        });
      },
      { capture: true },
    );
  }
</script>
